decl
int i, j, m, n, arr[4][4];
enddecl;

begin
    read(m);
    read(n);

    i = 0;
    while(i < m) do
        j = 0;
        while(j < n) do
            read(arr[i][j]);
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;

    i = 0;
    while(i < m) do
        j = 0;
        while(j < n) do
            write(arr[i][j]);
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;
end;