decl

enddecl

int main() {

    decl
        int a, b, c, d;
    enddecl

    begin
        read(a);
        read(b);
        read(c);
        read(d);

        if(a > 1 AND b > 1 OR c > 1 AND d > 1) then
            write("large");
        else
            write("small");
        endif;

        return 1;
    end
    
}