type
endtype

class
    animal {
        decl
            str name;
            int setname(str name);
            int speak();
        enddecl

        int setname(str name) {
            decl enddecl
            begin
                self.name = name;
                return 1;
            end
        }

        int speak() {
            decl enddecl
            begin
                write("Animal sound");
                return 1;
            end
        }
    }

    dog extends animal {
        decl
            str breed;
            int speak();
        enddecl

        int speak() {
            decl enddecl
            begin
                write("Bark Bark!");
                return 1;
            end
        }
    }
endclass

decl
    animal a;
    dog b;
enddecl

int main() {
    decl
        
    enddecl

    begin
        breakpoint;
        a = new(animal);
        breakpoint;
        b = new(dog);
        write("hi");
        return 0;
    end
}
