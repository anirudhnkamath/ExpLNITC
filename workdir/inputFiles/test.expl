type
    node {
        int val;
        node next;
    }
endtype

decl
    node a, b;
    int temp;
    int swapval(node x, node y);
enddecl

int swapval(node x, node y) {
    decl
        int t;
    enddecl

    begin
        t = x.val;
        x.val = y.val;
        y.val = t;
        return 1;
    end
}

int main()
{
    decl
    enddecl
    
    begin
        a = null;
        if(a == null) then
            write("hi");
        endif;

        return 1;
    end
}