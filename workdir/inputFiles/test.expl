type
endtype

class
    node {
        decl
            int val;
            int getVal();
            int setVal(int val);
        enddecl

        int getVal() {
            decl enddecl
            begin
                return self.val;
            end
        }

        int setVal(int val) {
            decl enddecl
            begin
                self.val = val;
                return val;
            end
        }
    }
endclass

decl
    int getter(node n2);
enddecl

int getter(node n2) {
    decl
        int temp;
    enddecl
    begin
        temp = n2.getVal();
        return temp;
    end
}

int main() {
    decl
        node n1, n2;
        int temp;
    enddecl

    begin
        n1 = new(node);
        temp = n1.setVal(96);
        write(getter(n1));
        return 1;
    end
}
