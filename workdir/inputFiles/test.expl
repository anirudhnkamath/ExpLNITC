decl
    int fib(int n);
enddecl

int fib(int n) {
    decl
        int ret;
    enddecl

    begin
        if(n <= 1) then
            if(n == 0) then
                ret = 0;
            else
                ret = 1;
            endif;
        
        else
            ret = fib(n-1) + fib(n-2);
        
        endif;
    end

    return(ret);
}

int main() {

    decl
       int n;
    enddecl

    begin
        read(n);
        write(fib(n));
    end
    
}