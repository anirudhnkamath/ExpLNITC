type
    newtype {
        int a;
        str b;
    }
endtype

class
    animal {
        decl
            str name;
            int setname(str name);
            int speak();
        enddecl

        int setname(str name) {
            decl enddecl
            begin
                self.name = name;
                return 1;
            end
        }

        int speak() {
            decl enddecl
            begin
                write("Animal sound");
                return 1;
            end
        }
    }

    dog extends animal {
        decl
            str breed;
            int speak();
        enddecl

        int speak() {
            decl enddecl
            begin
                write("Bark Bark!");
                return 1;
            end
        }
    }
endclass

decl
    animal a;
    dog b;
    animal x;
    int n;
enddecl

int main() {
    decl enddecl
    begin
        read(n);

        if (n > 10) then
            breakpoint;
            x = new(animal);
        else
            breakpoint;
            x = new(dog);
        endif;
        breakpoint;
        n = x.speak();
        return 0;
    end
}
