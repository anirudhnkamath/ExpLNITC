type
    newtype {
        int a;
        str b;
    }
endtype

class
    animal {
        decl
            str name;

            int speak();
            int speak(int loudness);
            
            int setname(str name);
        enddecl
    }

    dog extends animal {
        decl
          

            int speak(int loudness);
            
            
            int fetch();
        enddecl
    }

    poodle extends dog {
        decl
            int cutenesslevel;

            int speak(int loudness);
            
            int dotrick();
        enddecl
    }
endclass

decl
    newtype myVar; 
    poodle myPoodle;
enddecl

int main() {
    decl
        int x;
    enddecl
    begin
        x = myPoodle.speak(10);
        return 0;
    end
}