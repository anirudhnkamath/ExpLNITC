type
endtype

class
    parent{
        decl
            int x;
            int f(int a);
        enddecl

        int f(int a){
            decl
            enddecl
            begin
                write("in parent");
                return 1;
            end
        }

    }

    child extends parent{
        decl
            int y;
            int f(int a);
        enddecl

        int f(int a){
            decl
            enddecl
            begin
                write("in child class");
                return 0;
            end
        }
    }
endclass


decl
    parent obj;
enddecl

int main(){
    decl
        int x;
    enddecl

    begin
        obj = new(parent);
        x = obj.f(1);
        obj = new(child);
        x = obj.f(1);
        return 0;
    end
}