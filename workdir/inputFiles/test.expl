class
    animal {
        decl
            animal son;
            str name;
            int say(str word);
            int sonsay(str word);
        enddecl

        int sonsay(str word) {
            decl enddecl
            begin
                write("in son");
                write(word);
                return 1;
            end
        }

        int say(str word) {
            decl enddecl
            begin
                breakpoint;
                self.son = new(animal);
                breakpoint;
                return(self.son.sonsay(word));
            end
        }
    }
endclass

