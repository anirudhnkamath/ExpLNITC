type
    node {
        int val;
        node next;
    }
endtype

decl
    node a;
enddecl

int main()
{
    decl
    enddecl
    
    begin  
        a = alloc();
        a.next = alloc();
        read(a.next.val);
        write(a.next.val);

        breakpoint;
        
        free(a.next);
        read(a.next.val);
        write(a.next.val);
        return 1;
    end
}