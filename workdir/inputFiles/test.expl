type
    student {
        int age;
        str name;
    }
endtype

decl
    student s1;
enddecl

int main()
{
    decl
        student s2;
    enddecl

    begin  
        read(s1.age);
        read(s1.name);
        s2 = s1;
        write(s2.age);
        write(s2.name);
        return 1;
    end
}