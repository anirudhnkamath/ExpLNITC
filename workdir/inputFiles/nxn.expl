decl
    int n;
    int i, j, k;
    int m1[7][7], m2[7][7], res[7][7];
enddecl;

begin
    read(n);

    i = 0;
    while(i < n) do
        j = 0;
        while(j < n) do
            read(m1[i][j]);
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;

    i = 0;
    while(i < n) do
        j = 0;
        while(j < n) do
            read(m2[i][j]);
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;

    i = 0;
    while(i < n) do
        j = 0;
        while(j < n) do
            res[i][j] = 0;
            k = 0;
            while(k < n) do
                res[i][j] = res[i][j] + (m1[i][k] * m2[k][j]);
                k = k + 1;
            endwhile;
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;

    i = 0;
    while(i < n) do
        j = 0;
        while(j < n) do
            write(res[i][j]);
            j = j + 1;
        endwhile;
        i = i + 1;
    endwhile;

end;
